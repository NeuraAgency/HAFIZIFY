# ── Groq API Key ───────────────────────────────────────────────────────────────
# Required only if using the Groq cloud ASR endpoint (groq_transcriber.py).
# Get your key at: https://console.groq.com/keys
# Then copy this file to .env and fill in your key:
#
#   cp .env.example .env
#
# The system reads GROQ_API_KEY from the environment at runtime.
GROQ_API_KEY=your_groq_api_key_here

# ── HuggingFace Hub Token ──────────────────────────────────────────────────────
# Optional, but recommended once Combined Mode is used (hybrid_diacritic_pipeline.py
# downloads whisper-l-v3-turbo-quran-lora-dataset-mix from the Hub on first run).
# Without a token, HF Hub requests are rate-limited on a shared/anonymous pool —
# this does NOT cause the 1.6GB model to re-download on every run (that's cached
# locally in ~/.cache/huggingface/hub), it only affects the small "check for
# updates" metadata calls made on each startup.
# Get a token at: https://huggingface.co/settings/tokens (read-only is enough)
HF_TOKEN=your_huggingface_token_here

# ── CTranslate2 / faster-whisper CPU Threading & Compute Settings ────────────
# CT2_CPU_THREADS: Physical core count (e.g. 6 on 12-thread i7) to prevent thrashing
# CT2_INTER_THREADS: Inter-op thread count (default: 1)
# CT2_COMPUTE_TYPE: Quantization format (int8_float32, int8, float16, float32)
# CT2_CPU_THREADS=6
# CT2_INTER_THREADS=1
# CT2_COMPUTE_TYPE=int8_float32